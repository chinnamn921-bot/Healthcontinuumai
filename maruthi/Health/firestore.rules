rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user owns this patient record
    function isPatientOwner(patientId) {
      return isAuthenticated() && (request.auth.uid == patientId || request.auth.token.patientId == patientId);
    }
    
    // Helper function to validate doctor access code grants
    function hasDoctorAccessGrant(patientId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/access_grants/$(request.auth.token.grantId));
    }

    // ── Patients Collection ──
    match /patients/{patientId} {
      // Patient profile readable by owner, approved doctors, or demo/authenticated users
      allow read: if isAuthenticated() || isPatientOwner(patientId);
      allow write: if isPatientOwner(patientId) || (isAuthenticated() && request.resource.data.keys().hasAll(['name']));
      
      // ── Sub-collections: visits, medications, labs, documents, decisions ──
      match /visits/{visitId} {
        allow read: if isAuthenticated() || isPatientOwner(patientId);
        allow create, update: if isAuthenticated();
        allow delete: if isPatientOwner(patientId);
      }
      
      match /medications/{medicationId} {
        allow read: if isAuthenticated() || isPatientOwner(patientId);
        allow write: if isAuthenticated();
      }
      
      match /labs/{labId} {
        allow read: if isAuthenticated() || isPatientOwner(patientId);
        allow write: if isAuthenticated();
      }
      
      match /documents/{docId} {
        allow read: if isAuthenticated() || isPatientOwner(patientId);
        allow create, update: if isAuthenticated();
        allow delete: if isPatientOwner(patientId);
      }
      
      match /decisions/{decisionId} {
        allow read: if isAuthenticated() || isPatientOwner(patientId);
        allow write: if isAuthenticated();
      }
    }
    
    // ── Doctor Access Grants ──
    match /access_grants/{grantId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if false; // Audit logs are immutable
    }
  }
}
